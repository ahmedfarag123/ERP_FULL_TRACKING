{
  "name": "tailadmin-react",
  "private": true,
  "workspaces": [
    "driver_team",
    "dispatcher"
  ],
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.config.admin.ts --host",
    "dev:sales": "vite --config vite.config.sales.ts --host",
    "dev:driver": "npm --workspace @horecasmart/driver run dev -- --host",
    "build": "npm run build:all",
    "build:all": "tsc -b && vite build --config vite.config.admin.ts && vite build --config vite.config.sales.ts && npm run build:driver && npm run build:dispatcher",
    "build:admin": "tsc -b && vite build --config vite.config.admin.ts",
    "build:sales": "tsc -b && vite build --config vite.config.sales.ts",
    "build:driver": "npm --workspace @horecasmart/driver run build",
    "dev:dispatcher": "npm --workspace @horecasmart/dispatcher run dev -- --host",
    "build:dispatcher": "npm --workspace @horecasmart/dispatcher run build",
    "import:historical-customers": "node supabase/scripts/import-historical-customers-from-sheet.mjs",
    "import:calls": "node supabase/scripts/import-calls-from-sheet.mjs",
    "import:visits": "node supabase/scripts/import-visits-from-sheet.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:full": "npm run build:all && node scripts/deploy-all.mjs",
    "deploy:admin": "npm run build:admin && node scripts/deploy-admin-only.mjs",
    "preview:sales": "vite preview --config vite.config.sales.ts",
    "preview:driver": "npm --workspace @horecasmart/driver run preview -- --host",
    "check:pwa": "node scripts/pwa-readiness-check.mjs",
    "check:arabic": "node scripts/arabic-rtl-regression-checks.mjs",
    "check:driver-real-data": "node scripts/driver-real-data-regression-checks.mjs",
    "check:edge-security": "node scripts/edge-function-security-regression-checks.mjs",
    "check:db-security": "node scripts/database-security-regression-checks.mjs",
    "reset:all-temp-passwords": "node scripts/reset-all-temp-passwords.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@heroicons/react": "^2.2.0",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.99.2",
    "apexcharts": "^4.1.0",
    "clsx": "^2.1.1",
    "csstype": "^3.2.3",
    "flatpickr": "^4.6.13",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.9.0",
    "react": "^19.2.0",
    "react-apexcharts": "^1.7.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.5",
    "react-helmet-async": "^2.0.5",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.1.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "swiper": "^11.2.3",
    "tailwind-merge": "^3.0.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/postcss": "^4.0.8",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.2",
    "supabase": "^2.98.0",
    "tailwindcss": "^4.0.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vite-plugin-svgr": "^4.3.0"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/core": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/world": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  }
}
