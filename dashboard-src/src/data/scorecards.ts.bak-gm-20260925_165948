export const IMPLEMENTED_KEYS = SCORECARDS.filter((s) => s.implemented).map((s) => s.key);

export function getScorecardByKey(key: string): ScorecardDef | undefined {
  return SCORECARDS.find((s) => s.key === key);
}

export function getScorecardsByDepartment(department: string): ScorecardDef[] {
  return SCORECARDS.filter((s) => s.department === department);
}
