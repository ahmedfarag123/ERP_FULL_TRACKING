export interface ScorecardDef {
  key: string;
  department: string;
  scorecard: string;
  module: string;
  view: string;
  field: string;
  implemented: boolean;
  goodWhen?: "higher" | "lower";
  summaryFirst?: "amount" | "count";
}

export function isGoodDelta(def: Pick<ScorecardDef, "goodWhen">, delta: number | null): boolean | null {
  if (delta === null) return null;
  return (def.goodWhen ?? "higher") === "higher" ? delta >= 0 : delta < 0;
}

