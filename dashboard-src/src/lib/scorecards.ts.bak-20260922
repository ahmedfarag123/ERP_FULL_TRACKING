import { supabase } from "./supabase";

export interface ScorecardValue {
  scorecard_key: string;
  department: string;
  scorecard: string;
  value: number | null;
  currency: string | null;
  note: string | null;
  metadata: {
    module?: string;
    view?: string;
    field?: string;
    topVendors?: Array<{ id: number; name: string; outstanding: number }>;
    customerCount?: number | null;
    invoiceCount?: number | null;
    orderCount?: number | null;
    distinctProducts?: number | null;
    gmvTotal?: number | null;
    callsCount?: number | null;
    odooActivities?: number | null;
    weekly?: Array<{ label: string; dayLabel: string; from?: string; to?: string; count: number }>;
  } | null;
  period_start: string | null;
  period_end: string | null;
  created_at: string | null;
}

export interface ScorecardInvokeResult {
  code: string;
  status: string;
  module?: string;
  view?: string;
  field?: string;
  value: number | null;
  note?: string;
  error?: string;
}

export interface ScorecardLiveBundle {
  success: boolean;
  error?: string;
  asOf: string;
  values: ScorecardValue[];
  results: ScorecardInvokeResult[];
}

export async function fetchScorecardSnapshot(keys: string[]): Promise<Record<string, ScorecardValue>> {
  if (keys.length === 0) return {};
  const { data, error } = await supabase
    .from("scorecard_values")
    .select("*")
    .in("scorecard_key", keys)
    .order("created_at", { ascending: false });
  if (error) {
    throw new Error(error.message);
  }
  const map: Record<string, ScorecardValue> = {};
  const rows = (data ?? []) as ScorecardValue[];
  for (const row of rows) {
    if (!(row.scorecard_key in map)) {
      map[row.scorecard_key] = row;
    }
  }
  return map;
}

export interface ScorecardHistoryQuery {
  key: string;
  from?: string | null;
  to?: string | null;
}

export async function fetchScorecardHistory({ key, from, to }: ScorecardHistoryQuery): Promise<ScorecardValue[]> {
  let query = supabase
    .from("scorecard_values")
    .select("*")
    .eq("scorecard_key", key)
    .order("created_at", { ascending: true });
  if (from) {
    query = query.gte("created_at", from);
  }
  if (to) {
    query = query.lte("created_at", to);
  }
  const { data, error } = await query;
  if (error) {
    throw new Error(error.message);
  }
  return (data ?? []) as ScorecardValue[];
}

export interface SaturdayContext {
  latest: ScorecardValue | null;
  saturdays: ScorecardValue[];
}

function cairoDateParts(value: string | null): { date: string; weekday: number } | null {
  if (!value) return null;
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return null;
  const shifted = new Date(parsed.getTime() + 3 * 60 * 60 * 1000);
  const date = `${shifted.getUTCFullYear()}-${String(shifted.getUTCMonth() + 1).padStart(2, "0")}-${String(shifted.getUTCDate()).padStart(2, "0")}`;
  return { date, weekday: shifted.getUTCDay() };
}

export async function fetchSaturdayContext({ key, from, to }: ScorecardHistoryQuery): Promise<SaturdayContext> {
  const rows = await fetchScorecardHistory({ key, from, to });
  if (rows.length === 0) {
    return { latest: null, saturdays: [] };
  }
  const bySaturday = new Map<string, ScorecardValue>();
  for (const row of rows) {
    const info = cairoDateParts(row.created_at);
    if (!info || info.weekday !== 6) continue;
    if (!bySaturday.has(info.date)) {
      bySaturday.set(info.date, row);
    }
  }
  const saturdays = Array.from(bySaturday.values()).sort((a, b) =>
    String(b.created_at ?? "").localeCompare(String(a.created_at ?? ""))
  );
  return { latest: rows[rows.length - 1] ?? null, saturdays };
}

export async function fetchScorecardLive(
  codes: string[],
  window?: { from?: string | null; to?: string | null }
): Promise<{ bundle: ScorecardLiveBundle; fresh: Record<string, ScorecardValue> }> {
  const body: Record<string, unknown> = { codes };
  if (window?.from) body.from = window.from;
  if (window?.to) body.to = window.to;
  const { data, error } = await supabase.functions.invoke<ScorecardLiveBundle>("scorecards-odoo-query", {
    body,
  });
  if (error) {
    throw new Error(error.message);
  }
  if (!data?.success) {
    throw new Error((data as unknown as { error?: string })?.error ?? "Scorecard request failed.");
  }
  const fresh: Record<string, ScorecardValue> = {};
  for (const value of data.values ?? []) {
    const key = value.scorecard_key;
    fresh[key] = { ...(fresh[key] ?? {}), ...value } as ScorecardValue;
  }
  return { bundle: data, fresh };
}

export function formatScorecardValue(value: number | null, currency: string | null): string {
  if (value === null || value === undefined) return "—";
  const isPercent = value > -100 && value < 200 && String(currency ?? "").toLowerCase().includes("%");
  if (isPercent) return `${value.toFixed(2)}%`;
  const asNumber = Math.abs(value) >= 1000
    ? new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 }).format(value)
    : new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(value);
  return `${asNumber} ${String(currency ?? "").toUpperCase()}`.trim();
}