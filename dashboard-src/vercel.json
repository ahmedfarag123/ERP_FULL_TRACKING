{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:all",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/((?:sales|driver|dispatcher)/)?index\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/((?:sales|driver|dispatcher)/)?sw\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/((?:sales|driver|dispatcher)/)?admin-sw\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/((?:sales|driver|dispatcher)/)?assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/checkin/:path*",
      "destination": "/sales/checkin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sales",
      "destination": "/sales/index.html"
    },
    {
      "source": "/sales/:path*",
      "destination": "/sales/index.html"
    },
    {
      "source": "/driver",
      "destination": "/driver/index.html"
    },
    {
      "source": "/driver/:path*",
      "destination": "/driver/index.html"
    },
    {
      "source": "/dispatcher",
      "destination": "/dispatcher/index.html"
    },
    {
      "source": "/dispatcher/:path*",
      "destination": "/dispatcher/index.html"
    },
    {
      "source": "/((?!sales|driver|dispatcher|api|assets|_next).*)",
      "destination": "/index.html"
    }
  ]
}
